#include <format>
#include <iostream>
#include <string>
using namespace std;

int main()
{
  double a = 123.456789;
  cout << format("{:.2}", a) << endl;
  cout << format("{:.3}", a) << endl;
  cout << format("{:.4}", a) << endl;
  cout << format("{:.5}", a) << endl;
  cout << format("{:.20}", a) << endl;

  cout << "--------------" << endl;
  cout << format("{}", 97) << endl;
  cout << format("{:c}", 97) << endl;
  cout << format("{:b}", 97) << endl;
  cout << format("{:x}", 97) << endl;
  cout << "--------------" << endl;

}
